# Copy to .env and adjust as needed:  cp .env.example .env
# .env is gitignored; this file is the checked-in template.

# ── Database ────────────────────────────────────────────────────────────────
# Host-oriented URL: use this when running Alembic or the app directly on your
# machine against the dockerized Postgres (`docker compose up -d postgres`).
# Host port is 5433 (see docker-compose.yml — 5432 is left free for any other
# local Postgres). The `app` container overrides this with the in-network
# hostname `postgres` on 5432. The password here is a local-dev value for
# fully synthetic data — not a secret.
DATABASE_URL=postgresql+psycopg://phealth:phealth_dev_pw@localhost:5433/phealth

# ── Ingest auth ─────────────────────────────────────────────────────────────
# Shared secret for POST /ingest/* endpoints, sent as the X-API-Key header.
# Required — the app fails fast on startup if unset.
INGEST_API_KEY=phealth_dev_ingest_key

# ── LLM (Claude) ────────────────────────────────────────────────────────────
# API key for the Anthropic SDK. Powers (a) the section-detector regex-miss
# fallback during ingest (graceful path; the regex handles the well-formed
# synthetic chart), and (b) the Phase 3 cited-rationale endpoints
# /api/v1/patients/{id}/asam-loc and /tjc-audit. Obtain at
# https://console.anthropic.com/. Leave blank to disable both — ingest still
# runs on the regex-only happy path, and Phase 3 endpoints return 503 +
# rule-engine-only output per phase_3_PRD.md §5.9.
ANTHROPIC_API_KEY=

# Claude model id. Sonnet 4.6 is the default (phase_3_PRD.md §5.6); swap to
# claude-opus-4-7 if narration quality on a given chart is insufficient. The
# model is part of the Phase 3 cache key, so a swap creates a new namespace.
PHEALTH_LLM_MODEL=claude-sonnet-4-6

# Hard cap on LLM calls per ingest job — prevents a malformed document from
# running up an unbounded bill (Phase 1 PRD §7).
MAX_LLM_CALLS_PER_INGEST=5
