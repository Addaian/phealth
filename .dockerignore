# Keep the application image lean — exclude everything not needed to serve.
.git/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env
.env.*
# The synthetic export is uploaded to /ingest at runtime — it does not belong
# in the image. But data/seed/ (the ASAM + TJC reference catalogs) IS needed at
# runtime, so it is deliberately NOT excluded here and is COPYed in the Dockerfile.
data/synthetic_export/
documents/
tests/
*.md
.DS_Store
